-- Helper Functions
local function getRandomTarget()
    local availableTargets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            table.insert(availableTargets, player)
        end
    end
    
    if #availableTargets > 0 then
        return availableTargets[math.random(1, #availableTargets)]
    end
    return nil
end

-- Function to simulate Block (F Key)
local isBlocking = false
local function triggerBlock()
    if isBlocking then return end
    isBlocking = true
    
    -- Press F key
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.6) -- Duration to hold block
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    
    isBlocking = false
end

-- Target Selection & Auto Switch Logic
local function updateTargetLogic()
    if not Settings.AutoTarget then return end
    
    -- Check if current target is invalid, dead, or left
    if not Settings.SelectedTarget or 
       not Settings.SelectedTarget.Parent or 
       not Settings.SelectedTarget.Character or 
       not Settings.SelectedTarget.Character:FindFirstChild("Humanoid") or 
       Settings.SelectedTarget.Character.Humanoid.Health <= 0 then
       
        -- Pick a new target automatically
        Settings.SelectedTarget = getRandomTarget()
        if Settings.SelectedTarget then
            TargetStatus.Text = "à¹à¸à¹à¸²à¸«à¸¡à¸²à¸¢à¸à¸±à¸à¸à¸¸à¸à¸±à¸: " .. Settings.SelectedTarget.Name
        else
            TargetStatus.Text = "à¹à¸à¹à¸²à¸«à¸¡à¸²à¸¢à¸à¸±à¸à¸à¸¸à¸à¸±à¸: à¹à¸¡à¹à¸à¸"
        end
    end

    -- Teleport/Follow to Target
    if Settings.SelectedTarget and Settings.SelectedTarget.Character and Settings.SelectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = Settings.SelectedTarget.Character.HumanoidRootPart
            -- Move behind target
            myChar.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, Settings.TargetDistance)
        end
    end
end

-- Auto Block Detection Logic
local function checkIncomingSkills()
    if not Settings.AutoBlock then return end
    
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    
    local myPos = myChar.HumanoidRootPart.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local enemyChar = player.Character
            local enemyHRP = enemyChar:FindFirstChild("HumanoidRootPart")
            
            if enemyHRP then
                local dist = (enemyHRP.Position - myPos).Magnitude
                if dist <= Settings.BlockRadius then
                    -- Check if enemy is performing attack animation or has attack attributes
                    local enemyHumanoid = enemyChar:FindFirstChildOfClass("Humanoid")
                    if enemyHumanoid then
                        -- Detect playing animations (Attacks/Skills)
                        for _, track in ipairs(enemyHumanoid:GetPlayingAnimationTracks()) do
                            if track.IsPlaying and (track.Animation.AnimationId:find("attack") or track.Animation.AnimationId:find("skill") or track.WeightCurrent > 0.5) then
                                triggerBlock()
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end

