-- ----------------------------------------------------------------
-- 5. ตรวจจับการเปลี่ยนเพลงและการเล่นเพลงแบบ Realtime
-- ----------------------------------------------------------------
local function trackInstance(inst)
	if activeSoundBindings[inst] then return end
	
	if inst:IsA("Sound") then
		activeSoundBindings[inst] = true
		
		inst:GetPropertyChangedSignal("IsPlaying"):Connect(function()
			updateOrCreateSoundCard(inst)
		end)

		inst:GetPropertyChangedSignal("SoundId"):Connect(function()
			updateOrCreateSoundCard(inst)
		end)

		if inst.IsPlaying then
			updateOrCreateSoundCard(inst)
		end
		
	elseif inst:IsA("AudioPlayer") then
		activeSoundBindings[inst] = true

		inst:GetPropertyChangedSignal("IsPlaying"):Connect(function()
			updateOrCreateSoundCard(inst)
		end)

		inst:GetPropertyChangedSignal("AssetId"):Connect(function()
			updateOrCreateSoundCard(inst)
		end)

		if inst.IsPlaying then
			updateOrCreateSoundCard(inst)
		end
	end
end

-- ฟังก์ชันสแกนเพลงทั้งหมดในแมพ
local function scanAllSounds()
	for _, item in ipairs(scrollFrame:GetChildren()) do
		if item:IsA("Frame") then
			item:Destroy()
		end
	end
	emptyLabel.Visible = true

	for _, item in ipairs(game:GetDescendants()) do
		if item:IsA("Sound") or item:IsA("AudioPlayer") then
			trackInstance(item)
			if item.IsPlaying then
				updateOrCreateSoundCard(item)
			end
		end
	end
end

