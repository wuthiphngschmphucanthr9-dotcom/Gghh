-- ฟังก์ชันสร้างปุ่มเมนู
local function CreateButton(text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
    btn.Text = text
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Parent = Container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(50, 52, 65)
    stroke.Parent = btn

    return btn, stroke
end

-- 1. ปุ่มเลือกผู้เล่น
local SelectBtn, _ = CreateButton("เลือกผู้เล่น: [กดเพื่อเปลี่ยน]")
local PlayersList = {}
local CurrentIdx = 0

local function RefreshPlayers()
    PlayersList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(PlayersList, p.Name)
        end
    end
end

SelectBtn.MouseButton1Click:Connect(function()
    RefreshPlayers()
    if #PlayersList == 0 then
        SelectedPlayerName = ""
        SelectBtn.Text = "เลือกผู้เล่น: ไม่พบใครในห้อง"
        StatusLabel.Text = "สถานะ: ไม่มีคนอื่นในเซิร์ฟ"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    CurrentIdx = CurrentIdx + 1
    if CurrentIdx > #PlayersList then CurrentIdx = 1 end

    SelectedPlayerName = PlayersList[CurrentIdx]
    SelectBtn.Text = "เป้าหมาย: " .. SelectedPlayerName
    StatusLabel.Text = "สถานะ: เลือก " .. SelectedPlayerName แล้ว
    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
end)

-- 2. ปุ่มเปิด/ปิด วาร์ปติดหลัง
local TeleportBtn, TeleportStroke = CreateButton("วาร์ปติดหลัง: ปิด")

local function StartTeleportLoop()
    if TeleportConnection then TeleportConnection:Disconnect() end
    
    TeleportConnection = RunService.Heartbeat:Connect(function()
        if not TargetTeleportEnabled then return end
        if SelectedPlayerName == "" then return end

        local targetPlayer = Players:FindFirstChild(SelectedPlayerName)
        
        -- ถ้าเป้าหมายไม่อยู่ในห้อง (กดออกจากเกม)
        if not targetPlayer then
            TargetTeleportEnabled = false
            TeleportBtn.Text = "วาร์ปติดหลัง: ปิด"
            TeleportBtn.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
            TeleportStroke.Color = Color3.fromRGB(50, 52, 65)
            StatusLabel.Text = "สถานะ: เป้าหมายออกจากเกมแล้ว"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            if TeleportConnection then
                TeleportConnection:Disconnect()
                TeleportConnection = nil
            end
            return
        end

        local targetChar = targetPlayer.Character
        local myChar = LocalPlayer.Character

        if targetChar and myChar and targetChar:FindFirstChild("HumanoidRootPart") and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHrp = targetChar.HumanoidRootPart
            local myHrp = myChar.HumanoidRootPart
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            local myHum = myChar:FindFirstChildOfClass("Humanoid")

            -- ถ้าเป้าหมายยังมีชีวิตอยู่
            if targetHum and targetHum.Health > 0 and myHum and myHum.Health > 0 then
                StatusLabel.Text = "สถานะ: กำลังติดหลัง " .. SelectedPlayerName
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 180)

                -- คำนวณตำแหน่งไปอยู่ข้างหลัง
                local behindCFrame = targetHrp.CFrame * CFrame.new(0, 0, DistanceBehind)
                myHrp.CFrame = CFrame.new(behindCFrame.Position, targetHrp.Position + targetHrp.CFrame.LookVector * 10)
            else
                -- ถ้าเป้าหมายตาย หรือเราตาย ให้รอเกิดใหม่แล้วไปวาร์ปต่อ
                StatusLabel.Text = "สถานะ: รอเกิดใหม่..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            end
        else
            StatusLabel.Text = "สถานะ: กำลังโหลดตัวละคร..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
    end)
end

TeleportBtn.MouseButton1Click:Connect(function()
    if SelectedPlayerName == "" then
        StatusLabel.Text = "สถานะ: โปรดเลือกผู้เล่นก่อน!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    TargetTeleportEnabled = not TargetTeleportEnabled

    if TargetTeleportEnabled then
        TeleportBtn.Text = "วาร์ปติดหลัง: เปิด"
        TeleportBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 90)
        TeleportStroke.Color = Color3.fromRGB(0, 255, 150)
        StartTeleportLoop()
    else
        TeleportBtn.Text = "วาร์ปติดหลัง: ปิด"
        TeleportBtn.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
        TeleportStroke.Color = Color3.fromRGB(50, 52, 65)
        StatusLabel.Text = "สถานะ: ปิดการวาร์ป"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        if TeleportConnection then
            TeleportConnection:Disconnect()
            TeleportConnection = nil
        end
    end
end)

-- 3. ปุ่มเปิด/ปิด ล็อกกล้อง
local LockBtn, LockStroke = CreateButton("ล็อกกล้อง: ปิด")

LockBtn.MouseButton1Click:Connect(function()
    AutoLockEnabled = not AutoLockEnabled

    if AutoLockEnabled then
        LockBtn.Text = "ล็อกกล้อง: เปิด"
        LockBtn.BackgroundColor3 = Color3.fromRGB(130, 0, 140)
        LockStroke.Color = Color3.fromRGB(220, 0, 255)

        LockConnection = RunService.RenderStepped:Connect(function()
            if SelectedPlayerName ~= "" then
                local targetPlayer = Players:FindFirstChild(SelectedPlayerName)
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = targetPlayer.Character.HumanoidRootPart
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
                end
            end
        end)
    else
        LockBtn.Text = "ล็อกกล้อง: ปิด"
        LockBtn.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
        LockStroke.Color = Color3.fromRGB(50, 52, 65)
        if LockConnection then
            LockConnection:Disconnect()
            LockConnection = nil
        end
    end
end)

