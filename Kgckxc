local function CreateBtn(text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
    btn.Text = text
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Parent = Container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(55, 58, 70)
    stroke.Parent = btn

    return btn, stroke
end

-- 1. ปุ่มเลือกผู้เล่น
local SelectBtn, _ = CreateBtn("เลือกผู้เล่น: [กดเปลี่ยน]")
local PlayerList = {}
local CurrentIndex = 0

SelectBtn.MouseButton1Click:Connect(function()
    PlayerList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(PlayerList, p.Name)
        end
    end

    if #PlayerList == 0 then
        SelectedPlayerName = ""
        SelectBtn.Text = "เลือกผู้เล่น: ไม่พบใครในห้อง"
        StatusLabel.Text = "สถานะ: ไม่มีคนอื่นในเซิร์ฟ"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    CurrentIndex = CurrentIndex + 1
    if CurrentIndex > #PlayerList then CurrentIndex = 1 end

    SelectedPlayerName = PlayerList[CurrentIndex]
    SelectBtn.Text = "เป้าหมาย: " .. SelectedPlayerName
    StatusLabel.Text = "สถานะ: เลือก " .. SelectedPlayerName
    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
end)

-- 2. ปุ่มเปิด/ปิด วาร์ปติดหลัง
local TeleportBtn, TeleportStroke = CreateBtn("วาร์ปติดหลัง: ปิด")

local function StartTeleport()
    if TeleportConnection then TeleportConnection:Disconnect() end

    TeleportConnection = RunService.Heartbeat:Connect(function()
        if not TargetTeleportEnabled then return end
        if SelectedPlayerName == "" then return end

        local targetPlayer = Players:FindFirstChild(SelectedPlayerName)

        -- กรณีเป้าหมายออกจากเกม
        if not targetPlayer then
            TargetTeleportEnabled = false
            TeleportBtn.Text = "วาร์ปติดหลัง: ปิด"
            TeleportBtn.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
            TeleportStroke.Color = Color3.fromRGB(55, 58, 70)
            StatusLabel.Text = "สถานะ: เป้าหมายออกจากเกมแล้ว"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            if TeleportConnection then
                TeleportConnection:Disconnect()
                TeleportConnection = nil
            end
            return
        end

        local myChar = LocalPlayer.Character
        local targetChar = targetPlayer.Character

        if myChar and targetChar then
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            local myHum = myChar:FindFirstChildOfClass("Humanoid")

            if myHrp and targetHrp and targetHum and myHum then
                if targetHum.Health > 0 and myHum.Health > 0 then
                    StatusLabel.Text = "สถานะ: ติดหลัง " .. SelectedPlayerName
                    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 180)

                    -- วาร์ปไปซ้อนหลัง
                    local targetCFrame = targetHrp.CFrame
                    local behindPosition = targetCFrame.Position - (targetCFrame.LookVector * DistanceBehind)
                    local newCFrame = CFrame.new(behindPosition, targetHrp.Position)

                    if myChar:FindFirstChild("Humanoid") then
                        myChar:PivotTo(newCFrame)
                    else
                        myHrp.CFrame = newCFrame
                    end
                else
                    StatusLabel.Text = "สถานะ: รอเป้าหมายเกิดใหม่..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                end
            end
        else
            StatusLabel.Text = "สถานะ: รอตัวละครโหลด..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
    end)
end

TeleportBtn.MouseButton1Click:Connect(function()
    if SelectedPlayerName == "" then
        StatusLabel.Text = "สถานะ: โปรดเลือกผู้เล่นก่อน!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    TargetTeleportEnabled = not TargetTeleportEnabled

    if TargetTeleportEnabled then
        TeleportBtn.Text = "วาร์ปติดหลัง: เปิด"
        TeleportBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 90)
        TeleportStroke.Color = Color3.fromRGB(0, 255, 150)
        StartTeleport()
    else
        TeleportBtn.Text = "วาร์ปติดหลัง: ปิด"
        TeleportBtn.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
        TeleportStroke.Color = Color3.fromRGB(55, 58, 70)
        StatusLabel.Text = "สถานะ: ปิดการวาร์ป"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        if TeleportConnection then
            TeleportConnection:Disconnect()
            TeleportConnection = nil
        end
    end
end)

-- 3. ปุ่มเปิด/ปิด ล็อกกล้อง
local LockBtn, LockStroke = CreateBtn("ล็อกกล้อง: ปิด")

LockBtn.MouseButton1Click:Connect(function()
    AutoLockEnabled = not AutoLockEnabled

    if AutoLockEnabled then
        LockBtn.Text = "ล็อกกล้อง: เปิด"
        LockBtn.BackgroundColor3 = Color3.fromRGB(130, 0, 140)
        LockStroke.Color = Color3.fromRGB(220, 0, 255)

        LockConnection = RunService.RenderStepped:Connect(function()
            if SelectedPlayerName ~= "" then
                local targetPlayer = Players:FindFirstChild(SelectedPlayerName)
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = targetPlayer.Character.HumanoidRootPart
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
                end
            end
        end)
    else
        LockBtn.Text = "ล็อกกล้อง: ปิด"
        LockBtn.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
        LockStroke.Color = Color3.fromRGB(55, 58, 70)
        if LockConnection then
            LockConnection:Disconnect()
            LockConnection = nil
        end
    end
end)

