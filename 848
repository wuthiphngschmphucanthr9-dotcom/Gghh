-- Rainbow Effect Function
local function ApplyRainbowEffect(textLabel, stroke)
    task.spawn(function()
        local hue = 0
        while textLabel and textLabel.Parent do
            hue = (hue + 0.005) % 1
            local color = Color3.fromHSV(hue, 0.8, 1)
            textLabel.TextColor3 = color
            if stroke then
                stroke.Color = color
            end
            task.wait(0.03)
        end
    end)
end
