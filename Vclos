-- Auto Target Utility Functions
local function getValidTarget()
    local candidates = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character:FindFirstChild("HumanoidRootPart") then
            if plr.Character.Humanoid.Health > 0 then
                table.insert(candidates, plr)
            end
        end
    end

    if #candidates > 0 then
        return candidates[math.random(1, #candidates)]
    end
    return nil
end

-- Auto Block/Parry Trigger Function
local isParrying = false
local function triggerParry()
    if isParrying then return end
    isParrying = true

    -- Virtual press 'F' key
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.5)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)

    isParrying = false
end

-- Core Logic Loop
RunService.Heartbeat:Connect(function()
    -- 1. Auto Target & Auto Switch Logic
    if Config.AutoTarget then
        if not Config.CurrentTarget or 
           not Config.CurrentTarget.Parent or 
           not Config.CurrentTarget.Character or 
           not Config.CurrentTarget.Character:FindFirstChild("Humanoid") or 
           Config.CurrentTarget.Character.Humanoid.Health <= 0 then
            
            Config.CurrentTarget = getValidTarget()
            if Config.CurrentTarget then
                StatusLabel.Text = "à¹à¸à¹à¸²à¸«à¸¡à¸²à¸¢: " .. Config.CurrentTarget.DisplayName .. " (@" .. Config.CurrentTarget.Name .. ")"
            else
                StatusLabel.Text = "à¹à¸à¹à¸²à¸«à¸¡à¸²à¸¢: à¸à¹à¸à¸«à¸²à¹à¸¡à¹à¸à¸..."
            end
        end

        -- Teleport / Track Target
        if Config.CurrentTarget and Config.CurrentTarget.Character and Config.CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local myChar = LocalPlayer.Character
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local targetCFrame = Config.CurrentTarget.Character.HumanoidRootPart.CFrame
                myChar.HumanoidRootPart.CFrame = targetCFrame * CFrame.new(0, 0, Config.TargetDistance)
            end
        end
    end

    -- 2. Auto Block / Parry Logic
    if Config.AutoBlock then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local myPos = myChar.HumanoidRootPart.Position

            for _, enemy in ipairs(Players:GetPlayers()) do
                if enemy ~= LocalPlayer and enemy.Character then
                    local enemyHRP = enemy.Character:FindFirstChild("HumanoidRootPart")
                    local enemyHum = enemy.Character:FindFirstChildOfClass("Humanoid")

                    if enemyHRP and enemyHum then
                        local distance = (enemyHRP.Position - myPos).Magnitude
                        if distance <= Config.BlockRadius then
                            -- Check active attack animations
                            for _, track in ipairs(enemyHum:GetPlayingAnimationTracks()) do
                                if track.IsPlaying and (track.Animation.AnimationId:find("attack") or track.Animation.AnimationId:find("skill") or track.WeightCurrent > 0.4) then
                                    triggerParry()
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Button Interactions with Pink/Purple Animation
local function updateButtonVisual(button, stroke, state)
    if state then
        button.Text = "ON"
        button.BackgroundColor3 = Color3.fromRGB(230, 60, 200)
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        stroke.Color = Color3.fromRGB(230, 60, 200)
    else
        button.Text = "OFF"
        button.BackgroundColor3 = Color3.fromRGB(60, 50, 80)
        button.TextColor3 = Color3.fromRGB(150, 150, 170)
        stroke.Color = Color3.fromRGB(80, 40, 110)
    end
end

