local activeSounds = {} -- เก็บรายการ Sound ที่กำลังตรวจจับ

-- ฟังก์ชันดึง ID จาก Asset ID string (เช่น rbxassetid://12345 -> 12345)
local function extractSoundId(soundIdStr)
	local num = soundIdStr:match("%d+")
	return num or ""
end

-- ฟังก์ชันคัดลอกไอดีเข้า Clipboard
local function copyToClipboard(text)
	if setclipboard then
		setclipboard(text)
		showToast("คัดลอก ID: " .. text .. " แล้ว!")
	else
		-- กรณี Executor หรือ Roblox Engine ไม่รองรับ setclipboard
		showToast("ID: " .. text .. " (กด Copy ไม่รองรับในระบบนี้)")
	end
end

-- ฟังก์ชันสร้างการแสดงผลของเพลงในรายการ UI
local function createSoundCard(sound)
	local rawAssetId = sound.SoundId
	local soundId = extractSoundId(rawAssetId)

	if soundId == "" then return end
	if scrollFrame:FindFirstChild("Sound_" .. soundId) then return end -- ป้องกันการสร้างซ้ำ

	-- การ์ดเพลง
	local card = Instance.new("Frame")
	card.Name = "Sound_" .. soundId
	card.Size = UDim2.new(1, 0, 0, 60)
	card.BackgroundColor3 = Color3.fromRGB(35, 38, 52)
	card.BorderSizePixel = 0
	card.Parent = scrollFrame

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 8)
	cardCorner.Parent = card

	-- ข้อความชื่อเพลง/ID
	local infoLabel = Instance.new("TextLabel")
	infoLabel.Size = UDim2.new(1, -90, 1, 0)
	infoLabel.Position = UDim2.new(0, 10, 0, 0)
	infoLabel.BackgroundTransparency = 1
	infoLabel.Font = Enum.Font.Gotham
	infoLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
	infoLabel.TextSize = 12
	infoLabel.TextXAlignment = Enum.TextXAlignment.Left
	infoLabel.TextTruncate = Enum.TextTruncate.AtEnd
	infoLabel.Text = "🎵 กำลังโหลดข้อมูล...\nID: " .. soundId
	infoLabel.Parent = card

	-- ปุ่มคัดลอก ID
	local copyBtn = Instance.new("TextButton")
	copyBtn.Size = UDim2.new(0, 70, 0, 32)
	copyBtn.Position = UDim2.new(1, -78, 0.5, -16)
	copyBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 210)
	copyBtn.Font = Enum.Font.GothamBold
	copyBtn.Text = "คัดลอก"
	copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	copyBtn.TextSize = 11
	copyBtn.Parent = card

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = copyBtn

	-- Event เมื่อกดปุ่มคัดลอก
	copyBtn.MouseButton1Click:Connect(function()
		copyToClipboard(soundId)
	end)

	-- พยายามดึงชื่อเพลงจริงจาก Asset
	task.spawn(function()
		local success, info = pcall(function()
			return MarketplaceService:GetProductInfo(tonumber(soundId), Enum.InfoType.Asset)
		end)

		if card and card.Parent then
			if success and info and info.Name then
				infoLabel.Text = "🎵 " .. info.Name .. "\nID: " .. soundId
			else
				infoLabel.Text = "🎵 " .. (sound.Name ~= "" and sound.Name or "Unknown Sound") .. "\nID: " .. soundId
			end
		end
	end)

	-- ตรวจจับกรณีที่ Sound หยุดเล่น
	local playConnection
	playConnection = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
		if not sound.IsPlaying then
			if card and card.Parent then
				card:Destroy()
			end
			if playConnection then
				playConnection:Disconnect()
			end
		end
	end)
end

-- ----------------------------------------------------------------
-- 3. ตรวจจับ Sound ในเกมทั้งหมด (Workspace & SoundService)
-- ----------------------------------------------------------------
local MarketplaceService = game:GetService("MarketplaceService")

local function checkAndTrackSound(instance)
	if instance:IsA("Sound") then
		local function onPlayStateChanged()
			if instance.IsPlaying and instance.SoundId ~= "" then
				createSoundCard(instance)
			end
		end

		-- ตรวจสอบตอนแรก
		if instance.IsPlaying and instance.SoundId ~= "" then
			createSoundCard(instance)
		end

		-- ติดตามสถานะการเล่น
		instance:GetPropertyChangedSignal("IsPlaying"):Connect(onPlayStateChanged)
		instance:GetPropertyChangedSignal("SoundId"):Connect(onPlayStateChanged)
	end
end

-- ตรวจหา Sound ที่มีอยู่แล้วในแมพ
for _, obj in ipairs(game:GetDescendants()) do
	checkAndTrackSound(obj)
end

-- ตรวจหา Sound ใหม่ๆ ที่ถูกสร้างขึ้นมาระหว่างเล่น (เช่น มีคนเปิด Boombox หรือเปิดเพลงจากไอเทม)
game.DescendantAdded:Connect(function(obj)
	checkAndTrackSound(obj)
end)
