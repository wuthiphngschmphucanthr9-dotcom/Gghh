-- ฟังก์ชันสกัดเอาเฉพาะตัวเลข Sound ID
local function ExtractSoundId(rawId)
    if not rawId then return "" end
    local cleanId = string.match(tostring(rawId), "%d+")
    return cleanId or ""
end

-- ฟังก์ชันคัดลอกลง Clipboard
local function CopyToClipboard(text)
    if setclipboard then
        setclipboard(text)
    elseif syn and syn.write_clipboard then
        syn.write_clipboard(text)
    elseif Clipboard and Clipboard.set then
        Clipboard.set(text)
    else
        warn("Executor ของคุณไม่รองรับการคัดลอกลง Clipboard โดยอัตโนมัติ")
    end
end

