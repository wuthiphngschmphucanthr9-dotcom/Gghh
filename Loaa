-- ฟังก์ชันตรวจสอบ Instance ว่าเป็น Sound และมี ID หรือไม่
local function ProcessSound(instance)
    if instance:IsA("Sound") then
        local function CheckAndAdd()
            local cleanId = ExtractSoundId(instance.SoundId)
            if cleanId ~= "" and (instance.IsPlaying or instance.TimePosition > 0) then
                AddSoundCard(instance, cleanId)
            end
        end

        -- ตรวจสอบทันที
        CheckAndAdd()

        -- ฟังการทำงานเมื่อมีการเล่นเพลง
        instance.Played:Connect(function()
            local cleanId = ExtractSoundId(instance.SoundId)
            if cleanId ~= "" then
                AddSoundCard(instance, cleanId)
            end
        end)

        -- ตรวจจับกรณีเปลี่ยน SoundId ระหว่างทาง
        instance:GetPropertyChangedSignal("SoundId"):Connect(function()
            local cleanId = ExtractSoundId(instance.SoundId)
            if cleanId ~= "" and instance.IsPlaying then
                AddSoundCard(instance, cleanId)
            end
        end)
        
        -- ตรวจจับเมื่อ IsPlaying เปลี่ยนเป็น true
        instance:GetPropertyChangedSignal("IsPlaying"):Connect(function()
            if instance.IsPlaying then
                local cleanId = ExtractSoundId(instance.SoundId)
                if cleanId ~= "" then
                    AddSoundCard(instance, cleanId)
                end
            end
        end)
    end
end

-- สแกน Sound ทั้งหมดที่มีอยู่ในเกม ณ ปัจจุบัน
for _, item in ipairs(game:GetDescendants()) do
    pcall(function()
        ProcessSound(item)
    end)
end

-- ดักจับ Sound ใหม่ๆ ที่เพิ่งถูกสร้างขึ้นมาในเกม
game.DescendantAdded:Connect(function(item)
    pcall(function()
