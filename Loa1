local function toggleMinimize()
	isMinimized = not isMinimized
	if isMinimized then
		mainFrame:TweenSize(UDim2.new(0, 320, 0, minHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.25, true)
