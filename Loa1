-- ฟังก์ชันสร้าง Card แสดงผลเพลงในรายการ
local function addSoundToUI(soundId, sourceName)
	if not soundId or soundId == "" or soundId == "0" then return end
	
	-- ซ่อนข้อความเตือนเมื่อมีเพลงเล่น
	emptyLabel.Visible = false

	local cardName = "Card_" .. soundId
	local existingCard = scrollFrame:FindFirstChild(cardName)

	if existingCard then
		-- อัปเดตเวลาล่าสุดหากเล่นซ้ำ
		existingCard:SetAttribute("LastActive", os.time())
		return
	end

	-- สร้างการ์ดเพลงใหม่
	local card = Instance.new("Frame")
	card.Name = cardName
	card.Size = UDim2.new(1, 0, 0, 58)
	card.BackgroundColor3 = Color3.fromRGB(32, 35, 50)
	card.BorderSizePixel = 0
	card:SetAttribute("LastActive", os.time())
	card.Parent = scrollFrame

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 8)
	cardCorner.Parent = card

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = Color3.fromRGB(50, 55, 75)
	cardStroke.Thickness = 1
	cardStroke.Parent = card

	-- ข้อมูลเพลง
	local infoLabel = Instance.new("TextLabel")
	infoLabel.Size = UDim2.new(1, -95, 1, -8)
	infoLabel.Position = UDim2.new(0, 10, 0, 4)
	infoLabel.BackgroundTransparency = 1
	infoLabel.Font = Enum.Font.Gotham
	infoLabel.TextColor3 = Color3.fromRGB(230, 230, 240)
	infoLabel.TextSize = 11
	infoLabel.TextXAlignment = Enum.TextXAlignment.Left
	infoLabel.TextYAlignment = Enum.TextYAlignment.Center
	infoLabel.TextWrapped = true
	infoLabel.Text = "🎵 กำลังดึงชื่อเพลง...\nID: " .. soundId
	infoLabel.Parent = card

	-- ปุ่มคัดลอก
	local copyBtn = Instance.new("TextButton")
	copyBtn.Name = "CopyBtn"
	copyBtn.Size = UDim2.new(0, 75, 0, 32)
	copyBtn.Position = UDim2.new(1, -82, 0.5, -16)
	copyBtn.BackgroundColor3 = Color3.fromRGB(75, 95, 220)
	copyBtn.Font = Enum.Font.GothamBold
	copyBtn.Text = "คัดลอก ID"
	copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	copyBtn.TextSize = 11
	copyBtn.Parent = card

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = copyBtn

	copyBtn.MouseButton1Click:Connect(function()
		copyID(soundId, copyBtn)
	end)

	-- ดึงชื่อเพลงจริงจาก Roblox Marketplace
	task.spawn(function()
		local soundTitle = "เพลง ID: " .. soundId
		
		if nameCache[soundId] then
			soundTitle = nameCache[soundId]
		else
			local success, info = pcall(function()
				return MarketplaceService:GetProductInfo(tonumber(soundId), Enum.InfoType.Asset)
			end)
			if success and info and info.Name then
				soundTitle = info.Name
				nameCache[soundId] = soundTitle
			elseif sourceName and sourceName ~= "" then
				soundTitle = sourceName
			end
		end

		if card and card.Parent then
			infoLabel.Text = "🎵 " .. soundTitle .. "\nID: " .. soundId
		end
	end)
end

-- ----------------------------------------------------------------
-- 4. ระบบค้นหาและสแกน Sound / AudioPlayer ในเกม
-- ----------------------------------------------------------------
local function inspectInstance(inst)
	-- รองรับทั้ง Sound แบบเดิม และ AudioPlayer แบบใหม่
	if inst:IsA("Sound") then
		local function checkSound()
			local rawId = inst.SoundId
			local soundId = extractAssetId(rawId)
			
			-- ตรวจสอบว่ากำลังเปิดอยู่ หรือเล่นผ่าน TimePosition
			if soundId and (inst.IsPlaying or inst.TimePosition > 0) then
				addSoundToUI(soundId, inst.Name)
			end
		end

		checkSound()
		inst:GetPropertyChangedSignal("IsPlaying"):Connect(checkSound)
		inst:GetPropertyChangedSignal("SoundId"):Connect(checkSound)
		
	elseif inst:IsA("AudioPlayer") then
		local function checkAudioPlayer()
			local rawId = inst.AssetId
			local soundId = extractAssetId(rawId)
			if soundId and inst.IsPlaying then
				addSoundToUI(soundId, inst.Name)
			end
		end

		checkAudioPlayer()
		inst:GetPropertyChangedSignal("IsPlaying"):Connect(checkAudioPlayer)
		inst:GetPropertyChangedSignal("AssetId"):Connect(checkAudioPlayer)
	end
end

