		contentFrame.Visible = false
	else
		contentFrame.Visible = true
		mainFrame:TweenSize(UDim2.new(0, 320, 0, fullHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.25, true)
		minimizeBtn.Text = "−"
	end
end

